SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true
SMTP_DEBUG=true
PUBLIC_BASE_URL=http://127.0.0.1:8000
ESCALATION_EMAIL=admin@example.com

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=urbanresolve

# Security keys — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
CSRF_SECRET=REPLACE_WITH_GENERATED_SECRET
COOKIE_SECRET=REPLACE_WITH_GENERATED_SECRET
